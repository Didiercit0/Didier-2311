{
  "name": "snailpay",
  "version": "1.0.0",
  "description": "Servicio de pagos ficticios para recargas de saldo",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build:test && node --test .test-dist/test/*.test.js",
    "test:watch": "nodemon --watch src --watch test --ext ts --exec \"npm test\"",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && npm start\"",
    "build:test": "tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
